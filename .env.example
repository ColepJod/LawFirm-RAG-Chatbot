# Law Help - local-first configuration.
# Copy this file to .env. No cloud API key is required.
# Relative paths are resolved against PROJECT_ROOT (the repository root).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Law Help
ENVIRONMENT=local
# standard = bge-m3 + bge-reranker-v2-m3 + qwen3:8b (GPU recommended)
# cpu      = bge-small-en-v1.5 + ms-marco-MiniLM + qwen3:4b (no GPU required)
RESOURCE_PROFILE=cpu
# PROJECT_ROOT=S:/Agentic Law Firm Chatbot
DATA_DIR=data
ARTIFACTS_DIR=var/artifacts
LOCAL_MODEL_CACHE_DIR=.cache/huggingface
UPLOAD_DIR=var/uploads

# ---------------------------------------------------------------------------
# Ingestion and chunking
# ---------------------------------------------------------------------------
# pdfmux | unstructured | docling
PDF_PARSER=pdfmux
# recursive | structure
CHUNK_STRATEGY=structure
CHUNK_SIZE=512
# 96 tokens = 18.75% of 512, inside the recommended 10-25% range.
CHUNK_OVERLAP=96
MIN_CHUNK_CHARS=50
PRESERVE_TABLES=true
DEDUPLICATE_BY_HASH=true
INGESTION_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Embeddings (local, downloaded from Hugging Face on first use)
# ---------------------------------------------------------------------------
# Leave model values commented to use the selected RESOURCE_PROFILE.
# Standard profile: BAAI/bge-m3
# CPU profile:      BAAI/bge-small-en-v1.5
# Other options:    nomic-ai/nomic-embed-text-v1.5, sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_MAX_SEQ_LENGTH=8192
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# ---------------------------------------------------------------------------
# Vector store and hybrid retrieval
# ---------------------------------------------------------------------------
# chroma | qdrant
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_COLLECTION=lawfirm_docs
CHROMA_PERSIST_DIR=var/chroma
# Only needed when VECTOR_STORE_BACKEND=qdrant and using a server.
QDRANT_URL=
QDRANT_LOCAL_PATH=var/qdrant
# Index manifests, chunk store, and fingerprint metadata.
INDEX_DIR=var/index
# warn  = serve even when the index was built with different settings
# enforce = require a reindex before serving
INDEX_FINGERPRINT_MODE=enforce
TOP_K=6
DENSE_CANDIDATES=20
SPARSE_CANDIDATES=20
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
BM25_K1=1.5
BM25_B=0.75
# Drop reranked chunks below this cross-encoder score. -10 keeps all candidates.
RETRIEVAL_MIN_RERANK_SCORE=-10.0
# Maximum token budget for the generation context.
CONTEXT_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Local cross-encoder reranker
# ---------------------------------------------------------------------------
RERANKER_ENABLED=true
# Standard profile: BAAI/bge-reranker-v2-m3
# CPU profile:      cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=6
# RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_DEVICE=auto
# reranker = local cross-encoder filter (fast, default)
# llm      = one LLM call per retrieved document (slow, debugging only)
GRADER_MODE=reranker
# LRU cache entries for hybrid retrieval and reranking. 0 disables caching.
RETRIEVAL_CACHE_SIZE=128
# Pre-load embedding and reranker models during startup to avoid a cold first query.
WARMUP_ON_STARTUP=true
WARMUP_QUERY=firm overview

# ---------------------------------------------------------------------------
# Local LLM inference
# ---------------------------------------------------------------------------
# groq | ollama | vllm
# The example defaults to local Ollama so no cloud key is required.
LLM_PROVIDER=ollama
# Groq models: qwen/qwen3.8-27b, llama-3.3-70b-versatile, llama-3.1-8b-instant
# Ollama/vLLM models: qwen3:8b, qwen3:4b, mistral, phi4
# Leave blank to use the RESOURCE_PROFILE default (qwen3:4b on cpu).
# LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://127.0.0.1:11434
# Required only when LLM_PROVIDER=groq. Leave blank for Ollama/vLLM.
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=180
LLM_KEEP_ALIVE=5m

# ---------------------------------------------------------------------------
# LangGraph control loop and conversation memory
# ---------------------------------------------------------------------------
# memory | sqlite
# sqlite is recommended for a single-node deployment and preserves conversations
# across restarts. Use an external checkpoint store before scaling to multiple workers.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=var/checkpoints.sqlite
CHECKPOINT_TTL_SECONDS=86400
MAX_QUERY_REWRITES=2
MAX_GROUNDING_RETRIES=1
MAX_GRAPH_STEPS=25

# ---------------------------------------------------------------------------
# Evaluation thresholds (local-first, zero-cost)
# ---------------------------------------------------------------------------
GOLDEN_SET_PATH=evaluation/golden_set.jsonl
EVAL_OUTPUT_DIR=var/eval
EVAL_GROUNDEDNESS_MIN=0.85
EVAL_COMPLETENESS_MIN=0.75
EVAL_RELEVANCE_MIN=0.75
EVAL_CONSISTENCY_MIN=0.80
EVAL_CONFIDENCE_MIN=0.70
EVAL_IQS_MIN=0.80
EVAL_RETRIEVAL_PRECISION_MIN=0.15
EVAL_RETRIEVAL_HIT_RATE_MIN=0.95
EVAL_RETRIEVAL_MRR_MIN=0.85
EVAL_FAIL_ON_REGRESSION=true
# Leave commented to reuse LLM_MODEL for the optional ragnarok-ai adapter.
# EVAL_JUDGE_MODEL=qwen3:8b
RAGNAROK_CHECKPOINT_DIR=var/eval/checkpoints

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
JSON_LOGS=true
LOG_DIR=var/logs
TRACE_DIR=var/traces
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://127.0.0.1:3000
# Optional keys for a self-hosted Langfuse instance. Not cloud credentials.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Input/output guardrails
# ---------------------------------------------------------------------------
MAX_QUERY_CHARS=2000
PII_DETECTION_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Keep this at 1 for memory/sqlite checkpoints. Scale out only with an external store.
API_WORKERS=1
# Protects ingestion and document-management endpoints. Leave empty for
# localhost-only development; set it before exposing the API to a network.
ADMIN_API_TOKEN=
# Comma-separated origins when the UI is served from a different origin.
CORS_ORIGINS=
CHAT_STREAM_ENABLED=true
